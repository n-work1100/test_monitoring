# ============================================================================
# Секрети лабораторії. Скопіюйте у .env (він у .gitignore) і заповніть.
#   cp .env.example .env
# ============================================================================

# --- Nagios UI ---------------------------------------------------------------
# Хост-порт веб-інтерфейсу (docker-compose.yml: ${NAGIOS_PORT:-8080}:80).
# Якщо 8080 зайнятий (WordPress/phpMyAdmin) — поставте 8090 і перевірте:
#   ss -ltn | grep :8090
NAGIOS_PORT=8080

# --- SNMPv2c -----------------------------------------------------------------
# Read-only community. НЕ "public". Для реальних пристроїв — довгий випадковий
# рядок (openssl rand -base64 24), різний по сайтах.
# ВАЖЛИВО: для симуляторів значення мусить збігатися з sim/snmpd/snmpd.conf
# і sim/camera/snmpd.conf (там зараз lab_ro_c0mm), інакше всі SNMP-сервіси
# отримають Timeout. Міняєте community — міняйте в усіх трьох місцях.
SNMP_COMMUNITY=lab_ro_c0mm

# --- Telegram ----------------------------------------------------------------
# 1) @BotFather -> /newbot -> токен
# 2) додайте бота в групу NOC, напишіть будь-що, потім:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"  -> chat.id (для груп від'ємний)
TG_TOKEN=
TG_CHAT_ID=

# id топіка в групі (необов'язково, якщо алерти йдуть в окремий топік)
TG_THREAD_ID=
